{
  "name": "justinspace",
  "version": "1.1.0",
  "private": true,
  "license": "Zlib",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:unit": "node --test tests/*.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:types": "astro check && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:release": "npm run build:release && npm run test:e2e",
    "test:boundaries": "node --test tests/boundaries.test.mjs",
    "test:journal:render": "node --test tests/render/*.test.mjs",
    "test:startup:no-browser": "node scripts/journal-startup-check.mjs",
    "test:performance": "npm run build && node scripts/performance-measure.mjs",
    "journal:build": "node scripts/journal-build.mjs",
    "journal:setup": "playwright install chromium",
    "journal:verify": "node scripts/journal-verify.mjs",
    "journal:verify:dist": "node scripts/journal-verify.mjs --dist",
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "dev:full": "(sleep 3 && node src/justin-kit/components/local-activity-status/scripts/activity-monitor.mjs) & astro dev --host 0.0.0.0 --port 4321; kill %1 2>/dev/null",
    "build": "astro build && npm run journal:verify:dist",
    "build:release": "npm run journal:build && npm run build",
    "start": "NODE_ENV=production node dist/server/entry.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "monitor:activity": "node src/justin-kit/components/local-activity-status/scripts/activity-monitor.mjs",
    "monitor:install": "node scripts/install-activity-monitor.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@xyflow/react": "^12.11.1",
    "astro": "^7.0.3",
    "nanostores": "1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "0.2.3",
    "@types/node": "^20.19.25",
    "@types/three": "^0.186.0",
    "gray-matter": "4.0.3",
    "marked": "18.0.13",
    "pagedjs": "0.4.3",
    "playwright": "1.63.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "typescript": "^5.9.3"
  }
}
