{
  "name": "astro-justin-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "journal:build": "node scripts/journal-build.mjs",
    "journal:setup": "playwright install chromium",
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "dev:full": "(sleep 3 && node src/justin-kit/components/local-activity-status/scripts/activity-monitor.mjs) & astro dev --host 0.0.0.0 --port 4321; kill %1 2>/dev/null",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "monitor:activity": "node src/justin-kit/components/local-activity-status/scripts/activity-monitor.mjs",
    "monitor:install": "node scripts/install-activity-monitor.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@xyflow/react": "^12.11.1",
    "astro": "^7.0.3",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/three": "^0.186.0",
    "gray-matter": "4.0.3",
    "marked": "18.0.13",
    "pagedjs": "0.4.3",
    "playwright": "1.63.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "typescript": "^5.9.3"
  }
}
