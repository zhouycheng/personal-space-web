---
import BaseLayout from "/src/layouts/BaseLayout.astro";
import MineCanvas from "/src/components/mine-canvas/MineCanvas.astro";
import WorksPortfolio from "/src/components/works/WorksPortfolio.astro";
import InteractiveStudio from "../studio/InteractiveStudio.astro";
import MacOsDesktop from "/src/justin-kit/components/macos-desktop/MacOsDesktop.astro";
import { getMacOsDesktopEntries } from "/src/justin-kit/components/macos-desktop/runtime/desktop-scanner";
import { isAppPage, NAV_ITEMS, PAGE_TITLES, type AppPage } from "/src/app/navigation";
type Props = { initialPage?: AppPage };
const { initialPage = "home" } = Astro.props;
const activePage = isAppPage(initialPage) ? initialPage : "home";
const entries = await getMacOsDesktopEntries();
---
<BaseLayout title={PAGE_TITLES[activePage]}>
  <main class:list={["app-shell", "alpha-shell", activePage === "home" && "is-home-active"]} data-initial-page={activePage} aria-label="Justin OS">
    <div class="app-content">
      <section id="page-home" class:list={["app-page", activePage === "home" && "is-active"]} aria-label="工作室"><InteractiveStudio /></section>
      <section id="page-works" class:list={["app-page", activePage === "works" && "is-active"]} aria-label="作品集"><WorksPortfolio /></section>
      <section id="page-os" class:list={["app-page", "mine-page", activePage === "os" && "is-active"]} aria-label="我的"><MineCanvas /></section>
    </div>
    <div class="os-fullscreen-projection" data-os-fullscreen aria-hidden="true" inert>
      <MacOsDesktop entries={entries} />
      <header class="os-menu-bar" aria-label="Justin OS 菜单">
        <div class="os-menu-group os-menu-left">
          <strong>Justin OS</strong>
          <button class="os-menu-item" data-studio-return>← 返回工作室</button>
          <button class="os-menu-item" data-desktop-command="open-display-controls">显示控制</button>
          <button class="os-menu-item" data-desktop-command="arrange-icons">整理桌面</button>
        </div>
        <time data-os-time></time>
      </header>
    </div>
    <nav class="app-dock" aria-label="主导航" hidden={activePage === "home"}>
      {NAV_ITEMS.map(item => <a class:list={[activePage === item.page && "is-active"]} data-page={item.page} href={item.path}><span>{item.number}</span>{item.label}</a>)}
    </nav>
  </main>
  <script>import "./studioAppRuntime";</script>
</BaseLayout>
