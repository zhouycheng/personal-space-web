---
import "../styles/global.css";
import { siteIdentity } from '../../../data/repositories/siteIdentity';
import environmentBootstrap from 'virtual:environment-bootstrap';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = siteIdentity.brand,
  description = siteIdentity.description,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline set:html={environmentBootstrap} />
  </head>
  <body>
    <slot />
  </body>
</html>
