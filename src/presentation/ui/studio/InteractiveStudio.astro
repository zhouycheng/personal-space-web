---
import "./studio.css";
import StudioNavigation from "./StudioNavigation.astro";
import { siteIdentity } from '../../../data/repositories/siteIdentity';
---
<div class="studio" data-studio data-state="room">
  <div class="studio-scene" data-studio-scene aria-label="可交互的三维工作室">
    <p class="studio-loading" data-studio-status role="status" hidden></p>
    <span class="studio-tooltip" data-studio-tooltip hidden></span>
  </div>
  <p class="studio-signature">{siteIdentity.signature}</p>
  <StudioNavigation />
</div>
