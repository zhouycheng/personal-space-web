<div class="bgm-settings">
  <div class="bgm-settings-heading"><span class="bgm-mini-record" aria-hidden="true"></span><div><strong data-bgm-name>暂无音乐</strong><small data-bgm-artist></small></div></div>
  <div class="bgm-settings-transport">
    <button data-bgm-prev aria-label="上一首"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6v12M18 6l-9 6 9 6Z"/></svg></button>
    <button data-bgm-play aria-label="播放音乐">播放</button>
    <button data-bgm-next aria-label="下一首"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6v12M6 6l9 6-9 6Z"/></svg></button>
  </div>
  <label class="bgm-settings-volume">音量<input type="range" min="0" max="1" step="0.01" value="0.35" aria-label="音乐音量"/><output data-bgm-volume>35%</output></label>
  <p data-bgm-status role="status"></p>
  <p data-bgm-device hidden>请使用设备音量键调节</p>
</div>
