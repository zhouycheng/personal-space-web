---
import type { ProjectRecord } from "../../../contracts/content";
import "./project-download-menu.css";

type Props = {
  projectTitle: string;
  downloads: NonNullable<ProjectRecord["downloads"]>;
};

const { projectTitle, downloads } = Astro.props;
const menuId = `project-download-menu-${projectTitle.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const downloadDataJson = JSON.stringify(downloads).replace(/</g, "\\u003c");
---

<div class="project-download" data-project-download data-project-title={projectTitle}>
  <div class="project-download__control">
    <button
      class="project-download__primary"
      type="button"
      data-download-primary
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls={menuId}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"></path>
      </svg>
      <span data-download-label>选择下载</span>
    </button>
    <button
      class="project-download__toggle"
      type="button"
      data-download-toggle
      aria-label={`选择 ${projectTitle} 下载版本`}
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls={menuId}
    >
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
    </button>
  </div>

  <div class="project-download__menu" id={menuId} data-download-menu hidden>
    <div class="project-download__heading">
      <strong>{projectTitle} v{downloads.version}</strong>
      <a href={downloads.releasePage} target="_blank" rel="noreferrer">发布说明</a>
    </div>
    <div class="project-download__packages">
      {downloads.packages.map((downloadPackage) => (
        <a
          class="project-download__package"
          href={downloadPackage.href}
          data-download-package={downloadPackage.id}
        >
          <span class="project-download__package-copy">
            <strong>{downloadPackage.label}</strong>
            <small>{downloadPackage.description}</small>
          </span>
          <span class="project-download__package-meta">
            {downloadPackage.recommended && <em>推荐</em>}
            <span>{downloadPackage.format}</span>
          </span>
        </a>
      ))}
    </div>
  </div>

  <script type="application/json" data-download-data set:html={downloadDataJson}></script>
</div>

<script>import "./downloadMenuRuntime";</script>
