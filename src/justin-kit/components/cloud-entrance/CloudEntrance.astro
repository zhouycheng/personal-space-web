---
import './cloud-entrance.css';
type Props = { title?: string; loadingText?: string; readyText?: string };
const { title = 'Justin', loadingText = '正在加载场景', readyText = '点击拨开云雾' } = Astro.props;
---
<div class="cloud-entrance" data-cloud-entrance data-state="loading" data-title={title} data-loading-text={loadingText} data-ready-text={readyText} aria-label="网站准备页" aria-busy="true">
  <canvas data-cloud-canvas aria-hidden="true"></canvas>
  <span class="cloud-entrance__fallback" aria-hidden="true">{title}</span>
  <div class="cloud-entrance__information"><slot /></div>
  <div class="cloud-entrance__footer">
    <span class="cloud-entrance__status" data-cloud-status role="status" aria-live="polite">{loadingText}</span>
    <div class="cloud-entrance__error" data-cloud-error hidden>
      <button type="button" data-cloud-retry>重新准备</button>
      <slot name="fallback" />
    </div>
  </div>
  <noscript><style>.cloud-entrance{display:none!important}</style></noscript>
</div>
