---
import type { DesktopEntry } from "./runtime/types";
import SymbolDomeBackground from "../symbol-dome-background/SymbolDomeBackground.astro";
import "./macos-desktop.css";

type Props = {
  entries: DesktopEntry[];
  storageKey?: string;
  ariaLabel?: string;
};

const {
  entries,
  storageKey = "justin-os-desktop-icon-layout",
  ariaLabel = "桌面文件",
} = Astro.props;

const desktopDataJson = JSON.stringify({ entries, storageKey }).replace(/</g, "\\u003c");
---

<div class="macos-desktop" data-macos-desktop>
  <SymbolDomeBackground />

  <div class="macos-desktop-icons" data-macos-desktop-icons aria-label={ariaLabel}>
    {entries.map((entry) => (
      <button
        type="button"
        class={`macos-desktop-icon macos-desktop-icon--${entry.icon}`}
        data-desktop-entry={entry.id}
        aria-label={`打开 ${entry.title}`}
      >
        <span class="macos-icon-art" aria-hidden="true">
          {(entry.icon === "html" || entry.icon === "markdown") && (
            <span class="macos-file-badge">{entry.icon === "html" ? ".html" : ".md"}</span>
          )}
        </span>
        <span class="macos-desktop-label">{entry.title}</span>
      </button>
    ))}
  </div>

  <div class="macos-selection-box" data-macos-selection-box aria-hidden="true"></div>
  <div class="macos-window-layer" data-macos-window-layer aria-live="polite"></div>
  <script type="application/json" data-macos-desktop-data set:html={desktopDataJson}></script>
</div>

<script>import "./runtime/desktopRuntime.js";</script>
