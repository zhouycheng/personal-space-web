---
import JustinAppShell from "../../presentation/ui/app/JustinAppShell.astro";
import { journal } from "../../infrastructure/server/journal";
const article=journal.articles.find(a=>a.slug===Astro.params.slug);
if(!article)return new Response("日记不存在",{status:404});
---
<JustinAppShell initialPage="journal" journalSlug={article.slug}/>
